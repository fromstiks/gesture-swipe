<resources>

    <!-- Soft raised card that blends with the background (neumorphic look). -->
    <style name="NeuCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">6dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Small soft button, same colour as the surface → raised neumorphic feel. -->
    <style name="NeuButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">46dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:elevation">5dp</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
        <item name="rippleColor">#332C3040</item>
    </style>

    <!-- Primary accent button (Start / Stop). -->
    <style name="NeuButton.Primary" parent="NeuButton">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
