<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Header row: title + theme toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GestureSwipe"
                android:textColor="?attr/colorOnSurface"
                android:textSize="26sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeToggle"
                style="@style/NeuButton.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌙" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="18dp"
            android:text="Листай ленту жестом руки, не касаясь экрана."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <!-- Status lines -->
        <TextView
            android:id="@+id/statusCamera"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:textSize="14sp"
            android:text="Камера" />

        <TextView
            android:id="@+id/statusA11y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:textSize="14sp"
            android:text="Служба свайпов" />

        <TextView
            android:id="@+id/statusService"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:textSize="14sp"
            android:text="Распознавание" />

        <!-- ===== Scroll type ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingBottom="8dp"
            android:text="🎯  Тип скролла"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/scrollTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScrollHand"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="Рука" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScrollMotion"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="Палец" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScrollPinch"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="Щипок" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/scrollDesc"
            style="@style/HelpText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:textSize="12sp"
            android:text="…" />

        <!-- ===== Setup accordion ===== -->
        <TextView
            android:id="@+id/setupHeader"
            style="@style/AccordionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️  Первичная настройка   ▾" />

        <LinearLayout
            android:id="@+id/setupContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="8dp">

            <TextView
                style="@style/HelpText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Делается один раз. Иди строго по порядку — шаг 2 нужен, чтобы заработал шаг 3." />

            <!-- Step 1 -->
            <TextView
                style="@style/StepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Шаг 1 · Камера" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantCamera"
                style="@style/NeuButton.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Дать доступ к камере" />
            <TextView
                style="@style/HelpText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="В системном окне нажми «Разрешить» (и уведомления на Android 13+)." />

            <!-- Step 2 -->
            <TextView
                style="@style/StepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Шаг 2 · Разрешить ограниченные настройки" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAppInfo"
                style="@style/NeuButton.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Открыть «О приложении»" />
            <TextView
                style="@style/HelpText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Android блокирует спец. возможности у приложений не из Play Маркета. Снять блок:\n1. Зажми иконку GestureSwipe на рабочем столе.\n2. Нажми «О приложении» (значок ⓘ).\n3. Справа вверху нажми ⋮ (три точки).\n4. Выбери «Разрешить ограниченные настройки» (подтверди PIN/отпечатком).\n\nНет такого пункта? Сначала нажми «Включить службу» в шаге 3 — появится заглушка «ограниченный доступ» — закрой её и вернись сюда." />

            <!-- Step 3 -->
            <TextView
                style="@style/StepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Шаг 3 · Включить службу свайпов" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenA11y"
                style="@style/NeuButton.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Открыть спец. возможности" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoA11y"
                style="@style/NeuButton.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Включить службу автоматически (ADB)" />
            <TextView
                style="@style/HelpText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Спец. возможности → Установленные приложения → GestureSwipe → включи тумблер и нажми «Разрешить». Вверху экрана статус должен стать «✓ Служба свайпов — включена»." />

            <!-- Step 4 -->
            <TextView
                style="@style/StepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Шаг 4 · Окно поверх TikTok" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverlay"
                style="@style/NeuButton.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Разрешить окно поверх" />
            <TextView
                style="@style/HelpText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Включи тумблер «Показ поверх других приложений» — появится мини-превью камеры, чтобы видеть, куда держать руку." />

            <!-- Step 5 -->
            <TextView
                style="@style/StepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Шаг 5 · Работа в фоне (OnePlus/Xiaomi)" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBattery"
                style="@style/NeuButton.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Настройки батареи" />
            <TextView
                style="@style/HelpText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="Найди GestureSwipe и поставь «Не оптимизировать» / «Без ограничений». Ещё: в списке недавних приложений нажми на карточку GestureSwipe и «залочь» её (замочек) — иначе система выключит камеру в фоне." />
        </LinearLayout>

        <!-- Primary action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleService"
            style="@style/NeuButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Запустить распознавание" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreview"
            style="@style/NeuButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🔍 Отладка · превью и чувствительность" />

        <TextView
            android:id="@+id/modeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:text="Режим…" />

    </LinearLayout>
</ScrollView>
